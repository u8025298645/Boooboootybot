import logging
import os
import google.generativeai as genai
from telegram import Update
from telegram.ext import (
    ApplicationBuilder,
    ContextTypes,
    MessageHandler,
    filters,
)

TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
GEMINI_API_KEY = os.getenv("GEMINI_API_KEY")

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO,
)

genai.configure(api_key=GEMINI_API_KEY)

system_prompt = (
    "تو یک دستیار هوشمند، صمیمی، بامزه و خوش‌برخورد در یک گروه تلگرامی هستی. "
    "به زبان فارسی روان صحبت می‌کنی و پاسخ‌های کوتاه، دلنشین و کاربردی می‌دهی."
)

model = genai.GenerativeModel(
    model_name="gemini-1.5-flash",
    system_instruction=system_prompt,
)


async def respond_to_group(
    update: Update, context: ContextTypes.DEFAULT_TYPE
):
    if not update.message or not update.message.text:
        return

    user_text = update.message.text
    try:
        await context.bot.send_chat_action(
            chat_id=update.effective_chat.id, action="typing"
        )
        response = model.generate_content(user_text)
        if response.text:
            await update.message.reply_text(response.text)
    except Exception as e:
        print(f"Error: {e}")


def main():
    app = ApplicationBuilder().token(TELEGRAM_BOT_TOKEN).build()
    app.add_handler(
        MessageHandler(filters.TEXT & ~filters.COMMAND, respond_to_group)
    )
    print("🤖 Bot is running...")
    app.run_polling()


if __name__ == "__main__":
    main()
